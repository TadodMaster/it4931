# Copy to .env. Tunables live in shared/config/demo.yaml (+ profiles/); uncommenting a variable here overrides both.
RUN_ID=local
# LK_PROFILE=fast   # demo-fast: 1M events, 10k accounts, 500 tx/s (shared/config/profiles/fast.yaml)
SEED=42
SIM_SPEEDUP=144
# HISTORY_EVENTS=20000000
# NUM_ACCOUNTS=100000
# NUM_MERCHANTS=10000
# LIVE_RATE=2000
LATE_POS_RATIO=0.03
DUPLICATE_RATIO=0.01
OUT_OF_ORDER_JITTER_MS=2000
# Object store (SeaweedFS S3 API). Local demo credentials only.
S3_ACCESS_KEY=demo-access
S3_SECRET_KEY=demo-secret-change-me
