{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/transaction.v1.json",
  "title": "Wallet transaction event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "account_id", "event_time", "produced_at", "channel",
               "type", "amount", "merchant_id", "is_self_transfer", "pos_offline"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "account_id": {"type": "string", "pattern": "^A[0-9]{6}$"},
    "event_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"},
    "produced_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"},
    "channel": {"enum": ["APP", "POS"]},
    "type": {"enum": ["TOPUP", "PAYMENT", "REFUND", "TRANSFER_OUT", "TRANSFER_IN", "CASHBACK"]},
    "amount": {"type": "integer", "minimum": 1},
    "merchant_id": {"type": ["string", "null"], "pattern": "^M[0-9]{5}$"},
    "is_self_transfer": {"type": "boolean"},
    "pos_offline": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"enum": ["PAYMENT", "REFUND"]}}},
     "then": {"properties": {"merchant_id": {"type": "string"}}},
     "else": {"properties": {"merchant_id": {"type": "null"}}}}
  ]
}
