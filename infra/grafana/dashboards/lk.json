{
  "uid": "lk-lambda-kappa",
  "title": "Lambda vs Kappa",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "tags": ["lambda", "kappa"],
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Ingest rate (events/s into Kafka topic)", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "rate(lk_kafka_end_offset_total[30s])", "legendFormat": "ingest", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Consumer lag per group (messages)", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "lk_consumer_lag", "legendFormat": "{{group}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [
       {"matcher": {"id": "byName", "options": "lambda-speed"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
       {"matcher": {"id": "byName", "options": "kappa-v1"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
       {"matcher": {"id": "byName", "options": "kappa-v2"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]}]}},
    {"id": 3, "type": "timeseries", "title": "Flink checkpoint duration (ms)", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "flink_jobmanager_job_lastCheckpointDuration", "legendFormat": "{{job_name}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Flink checkpoint size (bytes)", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "flink_jobmanager_job_lastCheckpointSize", "legendFormat": "{{job_name}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 5, "type": "stat", "title": "Spark batch duration (s) and input rows", "gridPos": {"x": 8, "y": 8, "w": 4, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "lk_lambda_batch_duration_seconds", "legendFormat": "duration s", "refId": "A"}, {"expr": "lk_lambda_batch_input_rows", "legendFormat": "rows", "refId": "B"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Redis memory (bytes)", "gridPos": {"x": 12, "y": 8, "w": 4, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "lk_redis_used_memory_bytes", "legendFormat": "redis", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "ClickHouse query latency (s)", "gridPos": {"x": 16, "y": 8, "w": 4, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "lk_clickhouse_query_seconds", "legendFormat": "count(*) over kappa view", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 8, "type": "stat", "title": "Mismatch vs oracle (failed verification checks)", "gridPos": {"x": 20, "y": 8, "w": 4, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "lk_verify_failed_checks", "legendFormat": "{{arch}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}}
  ]
}
